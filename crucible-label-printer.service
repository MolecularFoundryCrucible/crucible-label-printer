[Unit]
Description=Crucible Label Printer MQTT
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lab
WorkingDirectory=/home/lab/crucible-label-printer
ExecStart=/home/lab/.local/bin/uv run python crucible_label_printer.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target